    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@sell-similar/tsconfig": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  }

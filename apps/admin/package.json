{
  "name": "@sell-similar/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3005 --strictPort",
    "build": "tsc --noEmit && vite build",

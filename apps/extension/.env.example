# Copy to apps/extension/.env:
#   cp apps/extension/.env.example apps/extension/.env
#
# WXT (Vite) loads env from this directory, NOT from the monorepo root, so the
# root .env cannot configure the extension. Only WXT_* variables reach the
# bundle, and they are inlined at BUILD time — rebuild or restart the dev
# server after changing them.

# Base URL of the api app. Read in entrypoints/background.ts, which falls back
# to http://127.0.0.1:3001 when unset. Keep in sync with API_PORT in the root
# .env; the origin must also appear in host_permissions in wxt.config.ts.
WXT_API_BASE_URL=http://127.0.0.1:3001
WXT_EXTENSION_INSTALLED_URL=http://127.0.0.1:3004/extension-installed

# For a public Chrome Web Store zip, set production URLs then:
#   pnpm --filter @sell-similar/extension zip
# WXT_API_BASE_URL=https://extension-api.carvmac.com
# WXT_EXTENSION_INSTALLED_URL=https://extension.carvmac.com/extension-installed

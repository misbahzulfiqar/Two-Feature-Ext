# Website (Vite + React). Never put secrets here — only VITE_* reaches the browser.

VITE_APP_URL=http://127.0.0.1:3004
VITE_API_URL=http://127.0.0.1:3001
# Optional once you have the 32-character ID. If empty, the site reads it from the
# /detail/ segment of VITE_CHROME_WEBSTORE_URL.
VITE_CHROME_EXTENSION_ID=
# Public Chrome Web Store listing. Must include /detail/ and the extension ID.
# Example: https://chromewebstore.google.com/detail/ebay-sell-similar/abcdefghijklmnopqrstuvwxyzabcdef
# Leave empty until Chrome publishes the listing so Install does not open the store homepage.
VITE_CHROME_WEBSTORE_URL=
VITE_EBAY_SELL_URL=https://www.ebay.com/sl/prelist

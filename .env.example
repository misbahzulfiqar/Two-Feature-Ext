NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://localhost:3001

# Database used by the API and Better Auth
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sell_similar

# Redis used by the scraper-worker queue
REDIS_URL=redis://127.0.0.1:6379

# MongoDB used by Agenda in the cron app
MONGO_URL=mongodb://127.0.0.1:27017/sell-similar

# Puppeteer (scraper-worker). Leave empty to use a locally installed Chrome.
CHROME_EXECUTABLE_PATH=

# eBay API credentials
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# Chrome extension (WXT exposes WXT_* to the client bundle)
WXT_API_BASE_URL=http://localhost:3001

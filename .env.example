NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://127.0.0.1:3001

# Database used by the API and Better Auth
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sell_similar

# Scraper-worker HTTP scrape (Process Listing). Redis/BullMQ is used for background eBay jobs.
# On Windows, start a portable Redis (no Memurai/MSI) with: pnpm redis:start
SCRAPER_WORKER_PORT=3002
SCRAPER_WORKER_URL=http://127.0.0.1:3002
REDIS_URL=redis://127.0.0.1:6379

# MongoDB used for eBay scrape job history (Atlas or local)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sell-similar?retryWrites=true&w=majority

# Puppeteer (scraper-worker). Leave empty to use a locally installed Chrome.
CHROME_EXECUTABLE_PATH=

# eBay API credentials
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# Chrome extension (WXT exposes WXT_* to the client bundle)
WXT_API_BASE_URL=http://127.0.0.1:3001

# Copy to .env at the monorepo root, then fill in the blanks:
#   cp .env.example .env
#
# Loaded by the Node apps (api, scraper-worker, cron) via loadRootEnv().
# The extension does NOT read this file — see apps/extension/.env.example.
#
# Every variable here is read by code and validated by Zod at startup:
#   apps/api/src/env.ts, apps/scraper-worker/src/env.ts, apps/cron/src/env.ts

# Shared: api, scraper-worker, cron
NODE_ENV=development
LOG_LEVEL=info

# api
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
# Website origin (Vite + React on port 3004). Better Auth trusts this origin for cookies/CORS.
WEB_APP_URL=http://127.0.0.1:3004
# Auth HTTP endpoints live on the API. Keep this aligned with API_BASE_URL.
BETTER_AUTH_URL=http://127.0.0.1:3001
# Minimum 32 characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
# Port must match SCRAPER_WORKER_PORT below.
SCRAPER_WORKER_URL=http://127.0.0.1:3003

# scraper-worker
SCRAPER_WORKER_PORT=3003
# puppeteer-core ships no browser. Leave empty to auto-detect an installed
# Chrome (see apps/scraper-worker/src/browser.ts); set it only if that fails.
CHROME_EXECUTABLE_PATH=

# Redis — optional. Powers the BullMQ scrape-listing queue. Needed, together
# with MONGO_URL, for POST /listings/scrape-jobs; without both it returns 503.
# The synchronous POST /listings/scrape path the extension uses needs neither.
# On Windows, start a portable Redis with: pnpm redis:start
REDIS_URL=redis://127.0.0.1:6379

# Optional. On API start, create or promote this account to role=admin.
# Leave empty in shared examples. Never commit real passwords.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_APP_URL=http://127.0.0.1:3005

# Email (verification + password reset). If neither Resend nor SMTP is set,
# the API logs the link so you can verify locally from the terminal.
EMAIL_FROM=eBay Sell Similar <noreply@ebaysellsimilar.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# MongoDB — Better Auth, scrape job history, and the cron app's Agenda backend.
# REQUIRED by the API for signup/login. The database name comes from the path
# segment, so keep /sell-similar.
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sell-similar?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/sell-similar
